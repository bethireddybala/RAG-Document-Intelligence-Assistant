# .env.example
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
#
# Usage (local development):
#   Rename this file to .env, add your key, then run:
#     streamlit run app.py
#
# The application reads GEMINI_API_KEY via:
#   1. os.environ.get("GEMINI_API_KEY")   ← .env file (if loaded by python-dotenv)
#   2. st.secrets["GEMINI_API_KEY"]       ← .streamlit/secrets.toml (Streamlit Cloud)
#   3. Sidebar text input                 ← manual entry in the UI
# ─────────────────────────────────────────────────────────────────

GEMINI_API_KEY=your_gemini_api_key_here
